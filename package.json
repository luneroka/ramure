{
  "name": "ramure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A free family-tree builder whose whole point is the tree: one canvas, the entire lineage.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply ramure --local",
    "db:migrate": "wrangler d1 migrations apply ramure --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.129.0"
  }
}
