{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/gedcom/**/*.ts", "../src/tree/**/*.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
